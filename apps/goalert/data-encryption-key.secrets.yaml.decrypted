# GoAlert's at-rest encryption key. GoAlert passes this value through a key
# derivation function (so any string works) and uses the derived key to
# encrypt sensitive data it stores in Postgres, e.g. signing keys. Every
# GoAlert replica must use the same value, and changing or losing it
# invalidates the data it protected.
#
# Generate a value:  openssl rand -base64 32
#
# Fill it in, then run ../../encrypt_secrets.sh — it encrypts this file to
# data-encryption-key.secrets.yaml (the name kustomization.yaml references)
# and deletes this plaintext copy.
apiVersion: v1
kind: Secret
metadata:
  name: goalert-data-encryption-key
type: Opaque
stringData:
  GOALERT_DATA_ENCRYPTION_KEY: CHANGEME
