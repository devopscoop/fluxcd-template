# GoAlert's at-rest encryption key, injected via the chart's envSecret
# pattern (the chart creates a Secret and envFroms it into the Deployment).
# GoAlert passes the value through a key derivation function (so any string
# works) and uses the derived key to encrypt sensitive data it stores in
# Postgres, e.g. signing keys. Every GoAlert replica must use the same value,
# and changing or losing it invalidates the data it protected — so set it
# BEFORE the first deploy: the CHANGEME below would otherwise silently become
# the key.
#
# Generate a value:  openssl rand -base64 32
#
# Fill it in, then run ../../encrypt_secrets.sh — it encrypts this file to
# helm_secrets.yaml and deletes this plaintext copy.
envSecret:
  GOALERT_DATA_ENCRYPTION_KEY: CHANGEME # pragma: allowlist secret
