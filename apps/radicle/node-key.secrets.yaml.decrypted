apiVersion: v1
kind: Secret
metadata:
  name: radicle-node-key
type: Opaque
stringData:
  # PLACEHOLDER -- replace both values before deploying. This is the node's
  # identity: the Node ID that peers dial (z6Mk...) is derived from it, so
  # generating a new one moves the node to a new address on the network.
  # Generate it once, keep this file as the backup of record, and see README.md
  # for the command.
  #
  # This Secret is mounted over $RAD_HOME/keys, so it has to carry both files --
  # the `rad` CLI reports "Radicle profile not found" without radicle.pub, even
  # though radicle-node itself only needs the private key.
  #
  # radicle is the multi-line OpenSSH-format private key from
  # $RAD_HOME/keys/radicle. Paste it as a block scalar (`radicle: |`, contents
  # indented beneath) and keep the trailing newline -- a block scalar preserves
  # exactly one, and the OpenSSH format needs it.
  radicle: REDACTED
  # radicle.pub is the single-line `ssh-ed25519 AAAA... radicle` from
  # $RAD_HOME/keys/radicle.pub.
  radicle.pub: REDACTED
