# The GitHub OAuth app this instance logs users in with, as the two
# environment variables Woodpecker reads them from. The chart creates a
# Secret named woodpecker-github-oauth from this list, and values.yaml's
# extraSecretNamesForEnvFrom hands it to the server.
#
# Register the OAuth App (not a GitHub App — Woodpecker's docs warn those
# break token refresh) under the GitHub organization: Settings → Developer
# settings → OAuth Apps → New OAuth App, with
#   Homepage URL:               https://woodpecker.project1-dev.devops.coop
#   Authorization callback URL: https://woodpecker.project1-dev.devops.coop/authorize
# then paste the client id and a generated client secret below. README.md
# has the full first-run sequence.
#
# Fill them in, then run ../../encrypt_secrets.sh — it encrypts this file to
# helm_secrets.yaml and deletes this plaintext copy.
server:
  secrets:
    - name: woodpecker-github-oauth
      data:
        WOODPECKER_GITHUB_CLIENT: CHANGEME # pragma: allowlist secret
        WOODPECKER_GITHUB_SECRET: CHANGEME # pragma: allowlist secret
