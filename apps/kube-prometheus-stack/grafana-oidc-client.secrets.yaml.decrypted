# The OAuth client secret Grafana itself presents to dex (the
# auth.generic_oauth block in values.yaml). It reaches Grafana as the
# GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET env var (envFromSecret in values.yaml),
# never through grafana.ini: the chart renders that whole section into a
# world-readable ConfigMap, and its assertNoLeakedSecrets check fails the
# render if a plaintext secret appears there. Pairs with the grafana
# staticClient in apps/dex/helm_secrets.yaml — generate ONE value
# (openssl rand -hex 24) into both files, and keep the same secret in
# apps/victoria-metrics (the stacks are either/or, keep them
# interchangeable). Harmless while the dex marker block in kustomization.yaml
# is commented out: nothing references this file until then.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-oidc-client-secret
stringData:
  GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: CHANGEME
