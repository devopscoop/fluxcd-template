# The password configure-harbor.sh (the Job) sets on robot$registry-mirrors,
# the Harbor robot account every node pulls through the proxy-cache projects
# as. A pod can only read Secrets in its own namespace, so this is a copy of
# node-robot.secrets.yaml, which the node DaemonSet reads in
# registry-mirrors: both carry the same value.
#
# README.md → "First run" generates one value into both files, then runs
# ../../encrypt_secrets.sh.
apiVersion: v1
kind: Secret
metadata:
  name: registry-mirrors-robot
  namespace: harbor
stringData:
  password: CHANGEME
