# Optional Docker Hub login for Harbor's dockerhub proxy-cache endpoint
# (configure-harbor.sh). Docker Hub rate-limits anonymous pulls per source
# IP, and all of Harbor's upstream pulls leave through the cluster's egress
# addresses, so a fresh cluster pulling its platform images can hit the
# limit. A personal access token with public-repo read scope is enough.
#
# Leave both empty for anonymous pulls. Fill them in, then run
# ../../encrypt_secrets.sh — it encrypts this file to
# dockerhub-credentials.secrets.yaml and deletes this plaintext copy.
apiVersion: v1
kind: Secret
metadata:
  name: harbor-proxy-cache-dockerhub
  namespace: harbor
stringData:
  username: ""
  token: "" # pragma: allowlist secret
