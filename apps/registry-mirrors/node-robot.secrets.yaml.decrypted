# The password of robot$registry-mirrors, the Harbor robot account every
# node pulls through the proxy-cache projects as. write-hosts.sh (the node
# DaemonSet) puts it in each hosts.toml as an Authorization header. A pod
# can only read Secrets in its own namespace, so this is a copy of
# node-robot-harbor.secrets.yaml, which configure-harbor.sh (the Job, in the
# harbor namespace) sets as the robot's password: both carry the same value.
#
# README.md → "First run" generates one value into both files, then runs
# ../../encrypt_secrets.sh.
apiVersion: v1
kind: Secret
metadata:
  name: registry-mirrors-robot
  namespace: registry-mirrors
stringData:
  password: CHANGEME
