# The OIDC client secret Envoy Gateway presents to dex when running the SSO
# filter (oidc-securitypolicy.yaml). A SecurityPolicy can only read Secrets
# in its own namespace, so this is a copy of the one in
# apps/victoria-metrics: all of them carry the same value as the
# envoy-gateway staticClient in apps/dex/helm_secrets.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: eg-oidc-client-secret
stringData:
  client-secret: CHANGEME
