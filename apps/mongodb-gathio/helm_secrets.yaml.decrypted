# MongoDB credentials. Fill these in, then encrypt with ./encrypt_secrets.sh.
#
# userDatabase makes the chart run createUser inside the gathio database on
# first start (roles: readWrite, dbAdmin), so gathio's connection string needs
# no ?authSource= qualifier. The password must match GATHIO_MONGODB_URL in
# apps/gathio/helm_secrets.yaml.
#
# These apply only on FIRST start, against an empty data directory. See
# README.md for how to rotate them afterwards.
# settings:
#   rootUsername: root
#   rootPassword: CHANGEME-root-password
# userDatabase:
#   name: gathio
#   user: gathio
#   password: CHANGEME-gathio-password
{}
