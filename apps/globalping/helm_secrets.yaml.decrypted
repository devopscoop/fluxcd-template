# The Globalping adoption token, injected via the chart's envSecret pattern
# (the chart creates a Secret and envFroms it into the Deployment). With it,
# the probe adopts itself into the Globalping account the token belongs to,
# which is what earns that account measurement credits and higher rate
# limits. With a wrong or placeholder token the probe still connects and
# measures; it just logs that the token matched no account and stays
# unadopted.
#
# Copy the GP_ADOPTION_TOKEN value from the `docker run` command that the
# Globalping dashboard (https://dash.globalping.io) generates.
#
# Fill it in, then run ../../encrypt_secrets.sh -- it encrypts this file to
# helm_secrets.yaml and deletes this plaintext copy.
envSecret:
  GP_ADOPTION_TOKEN: CHANGEME # pragma: allowlist secret
