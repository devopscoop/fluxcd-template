# https://longhorn.io/docs/1.10.1/advanced-resources/security/volume-encryption/
apiVersion: v1
kind: Secret
metadata:
    name: longhorn-crypto
    namespace: longhorn-system
stringData:
    CRYPTO_KEY_VALUE: CHANGEME
    CRYPTO_KEY_PROVIDER: secret
    CRYPTO_KEY_CIPHER: aes-xts-plain64
    CRYPTO_KEY_HASH: sha256
    CRYPTO_KEY_SIZE: "256"
    CRYPTO_PBKDF: argon2i
