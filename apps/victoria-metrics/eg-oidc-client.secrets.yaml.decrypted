# The OIDC client secret Envoy Gateway presents to dex when running the SSO
# filter (oidc-securitypolicy.yaml). Generate ONE value (openssl rand -hex
# 24) and set it in three places: here, the same secret in
# apps/kube-prometheus-stack (the stacks are either/or, keep them
# interchangeable), and the envoy-gateway staticClient in
# apps/dex/helm_secrets.yaml. Harmless while the dex marker block in
# kustomization.yaml is commented out: nothing references this file until
# then.
apiVersion: v1
kind: Secret
metadata:
  name: eg-oidc-client-secret
stringData:
  client-secret: CHANGEME
