# The secret half of the Alertmanager alert-routing config (the `>>> slack`
# block in values.yaml holds the non-secret root route). The route.routes and
# receivers lists live here IN FULL, non-secret parts included, because Flux
# merges valuesFrom like `helm -f`: maps deep-merge, but lists are replaced
# wholesale, so each list must live entirely in one file — and two of the
# values are secrets: a Slack incoming-webhook URL lets anyone holding it post
# to your workspace, and the GoAlert webhook URL embeds an integration key
# that can open (and close) alerts. deploy.sh SOPS-encrypts this file into
# helm_secrets.yaml; on a running cluster edit with `sops helm_secrets.yaml`.
#
# Routing: Watchdog is blackholed (it fires always, by design, to prove the
# alerting pipeline works — page on its ABSENCE via a GoAlert heartbeat
# monitor instead); every other alert goes to BOTH GoAlert (paging) and Slack:
# the match-everything goalert sub-route sets continue: true and falls through
# to the match-everything slack sub-route. See README.md → "Alert routing".
#
# To enable: uncomment the alertmanager block (deleting the trailing `{}`),
# create a Slack webhook (https://api.slack.com/messaging/webhooks) and
# replace the placeholder slack_api_url, set your channel, and paste the
# GoAlert integration-key URL into the goalert receiver (see
# apps/goalert/README.md → "Wiring Alertmanager to GoAlert"). Harmless while
# Slack alerting is off: no receiver is referenced until the `>>> slack` block
# in values.yaml is uncommented.
# alertmanager:
#   config:
#     global:
#       slack_api_url: https://hooks.slack.com/services/REPLACE/ME/replaceme
#     route:
#       routes:
#         # The chart's default route sends Watchdog to a null receiver, and
#         # restating routes here replaces that whole list, so keep the
#         # blackhole first — a Watchdog page would be pure noise.
#         - receiver: blackhole
#           matchers:
#             - alertname = Watchdog
#         # Everything else pages via GoAlert ...
#         - receiver: goalert
#           continue: true
#         # ... and also lands in Slack.
#         - receiver: slack
#     receivers:
#       - name: blackhole
#       - name: slack
#         slack_configs:
#           - channel: '#alerts' # TODO: replace with your Slack channel
#             send_resolved: true
#             # Alertmanager's default Slack message is only a terse title like
#             # "[FIRING:2] (ns/pod critical)". Keep that as the headline, but
#             # render each alert's summary, description, and runbook in the body.
#             title: '{{ template "slack.default.title" . }}'
#             text: |-
#               {{ range .Alerts }}*{{ .Labels.alertname }}* `{{ .Labels.severity }}`{{ if .Annotations.summary }} — {{ .Annotations.summary }}{{ end }}
#               {{ .Annotations.description }}{{ if .Annotations.runbook_url }} <{{ .Annotations.runbook_url }}|:book: runbook>{{ end }}
#               {{ end }}
#       - name: goalert
#         webhook_configs:
#           # The Prometheus Alertmanager integration-key URL from GoAlert
#           # (apps/goalert/README.md). send_resolved lets GoAlert auto-close
#           # the alert when Alertmanager resolves it.
#           - url: https://goalert.devops.coop/api/v2/prometheusalertmanager/incoming?token=REPLACEME
#             send_resolved: true

# grafana:
#   adminPassword: CHANGEME

# The {} keeps this file valid YAML while everything above is commented out
# (sops errors on a comments-only file, which would break deploy.sh's encrypt
# loop). Delete it when you uncomment any of the values above.
{}
