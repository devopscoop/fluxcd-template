# Alertmanager -> Slack: an incoming-webhook URL lets anyone holding it post
# to your workspace, so it lives here (global.slack_api_url, used by the slack
# receiver below).
#
# GoAlert receiver -- see apps/goalert/README.md ("Wiring
# Alertmanager to GoAlert"). The webhook URL embeds the integration key
# (anyone holding it can open and close alerts), which is why the receiver
# lives in this file and not in values.yaml.
#
# NOTE: Flux merges valuesFrom like `helm -f`: maps deep-merge but lists are
# replaced wholesale, so each list must live entirely in one file. The
# route.routes and receivers lists live only here (this file is the secret
# one); values.yaml defines just the default route receiver
# (route.receiver: slack).
alertmanager:
    config:
        global:
            slack_api_url: https://hooks.slack.com/services/REDACTED/REDACTED/REDACTED
        route:
            routes:
                # Watchdog fires nonstop by design -- it exists to prove the
                # alerting pipeline works end to end, so it belongs somewhere
                # that notices its *absence* (e.g. a GoAlert heartbeat
                # monitor), not on the Slack board. Blackhole it until that's
                # wired up.
                - receiver: blackhole
                  matchers:
                    - alertname = "Watchdog"
                # Every remaining alert goes to BOTH GoAlert (paging) and
                # Slack: a route with no matchers matches everything, and
                # `continue: true` keeps evaluating siblings, falling through
                # to the slack route below. Without that explicit slack route
                # nothing would reach Slack -- the root receiver in values.yaml
                # only fires when NO sub-route matches.
                - receiver: goalert
                  continue: true
                - receiver: slack
        receivers:
            # The chart's default route sends Watchdog alerts to the 'null'
            # receiver, and setting receivers here replaces the chart's whole
            # list, so keep blackhole.
            - name: blackhole
            - name: slack
              slack_configs:
                - channel: '#alerts-project1-dev'
                  send_resolved: true
                  # Alertmanager's default Slack message is only a terse title
                  # like "[FIRING:2] (ns/pod critical)". Keep that as the
                  # headline, but render each alert's summary, description,
                  # and runbook in the body.
                  title: '{{ template "slack.default.title" . }}'
                  text: |-
                    {{ range .Alerts }}*{{ .Labels.alertname }}* `{{ .Labels.severity }}`{{ if .Annotations.summary }} — {{ .Annotations.summary }}{{ end }}
                    {{ .Annotations.description }}{{ if .Annotations.runbook_url }} <{{ .Annotations.runbook_url }}|:book: runbook>{{ end }}
                    {{ end }}
            - name: goalert
              webhook_configs:
                # The token is the integration key from the GoAlert service
                # (Integration Keys -> Key Type "Prometheus Alertmanager").
                - url: https://goalert.project1-dev.devops.coop/api/v2/prometheusalertmanager/incoming?token=REDACTED
                  send_resolved: true
grafana:
# TODO: set this when you deploy. If we leave this uncommented, people will likely have their password actually set to the string "REDACTED", which is undesirable.
#     adminPassword: REDACTED
