# Harbor's own secrets — the chart's defaults for all three are fixed
# strings published in its values.yaml, so every one must be replaced before
# the first install. Generate them with openssl (README.md → "First run"),
# then run ../../encrypt_secrets.sh — it encrypts this file to
# helm_secrets.yaml and deletes this plaintext copy.
#
# The other internal secrets (core.secret, core.xsrfKey, jobservice.secret,
# registry.secret) need nothing here: when unset, the chart generates them
# once and its lookup() keeps the in-cluster values across upgrades.

# The initial password of Harbor's built-in `admin` user. Harbor reads it
# only when it initializes an empty database; after that it lives in the
# database, so rotate it in the UI (and keep this file in step so a restore
# onto an empty database doesn't resurrect an old one).
harborAdminPassword: CHANGEME # pragma: allowlist secret

# The key Harbor encrypts stored credentials with — replication endpoints'
# and proxy-cache upstreams' passwords, among others. EXACTLY 16 characters
# (openssl rand -hex 8), and it must never change: a new key leaves every
# stored credential undecryptable.
secretKey: CHANGEME # pragma: allowlist secret

# harbor-core authenticates to the registry with this basic-auth password
# (the chart renders the matching htpasswd). Internal only, but the chart's
# default is public.
registry:
  credentials:
    password: CHANGEME # pragma: allowlist secret
