apiVersion: v1
kind: Secret
metadata:
  name: renovate-github-app
type: Opaque
stringData:
  # The App ID is on the GitHub App's General settings page.
  app-id: "000000"
  # The number at the end of the app's installation URL:
  # https://github.com/organizations/<org>/settings/installations/<id>
  installation-id: "00000000"
  # The full PEM private key generated on the app's General settings page.
  private-key: REPLACE_WITH_THE_GITHUB_APP_PRIVATE_KEY_PEM
