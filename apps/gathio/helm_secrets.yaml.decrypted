# The MongoDB connection string, which config.toml reads as
# ${GATHIO_MONGODB_URL}. The user, password and database must match
# userDatabase in mongodb.helm_secrets.yaml, alongside it. Fill this in, then
# encrypt with ./encrypt_secrets.sh:
# envSecret:
#   GATHIO_MONGODB_URL: mongodb://gathio:CHANGEME@mongodb.gathio.svc.cluster.local:27017/gathio # pragma: allowlist secret
{}
