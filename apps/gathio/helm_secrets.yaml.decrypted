# The MongoDB connection string, which config.toml reads as
# ${GATHIO_MONGODB_URL}. The user, password and database must match
# userDatabase in apps/mongodb-gathio/helm_secrets.yaml. Fill this in, then
# encrypt with ./encrypt_secrets.sh:
# envSecret:
#   GATHIO_MONGODB_URL: mongodb://gathio:CHANGEME@mongodb-gathio.gathio.svc.cluster.local:27017/gathio # pragma: allowlist secret
{}
