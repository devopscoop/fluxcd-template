# Environment for AutoKuma's templated monitor definitions, used only with the
# kuma-heartbeat block enabled (kustomization.yaml, deployment.yaml). AutoKuma
# only lets templates read variables named AUTOKUMA__ENV__*.
#
# AUTOKUMA__ENV__HEARTBEAT_URL is the URL of the heartbeat monitor that watches
# this Uptime Kuma, in a GoAlert OUTSIDE this cluster (apps/goalert/README.md ->
# "Uptime Kuma heartbeat"). Anyone holding it can keep that monitor looking
# healthy, hence a secret.
#
# Fill it in, then run ../../encrypt_secrets.sh -- it encrypts this file to
# autokuma-env.secrets.yaml (the name kustomization.yaml references) and
# deletes this plaintext copy.
apiVersion: v1
kind: Secret
metadata:
    name: autokuma-env
type: Opaque
stringData:
    AUTOKUMA__ENV__HEARTBEAT_URL: REDACTED
