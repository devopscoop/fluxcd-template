# Uptime Kuma admin credentials for AutoKuma's socket.io login.
# Fill in the real values, then run ../../encrypt_secrets.sh — it encrypts
# this file to kuma-credentials.secrets.yaml (the name kustomization.yaml
# references) and deletes this plaintext copy.
apiVersion: v1
kind: Secret
metadata:
    name: autokuma-kuma-credentials
type: Opaque
stringData:
    AUTOKUMA__KUMA__USERNAME: REDACTED
    AUTOKUMA__KUMA__PASSWORD: REDACTED
