# Secret-bearing Dex config. Flux deep-merges this over values.yaml, so put
# whole config blocks here whenever any key in them is sensitive:
#
#   - config.connectors — the upstream IdP federation, because each connector
#     carries the client secret issued by that IdP.
#   - config.staticClients — the WHOLE list: Flux merges valuesFrom like
#     `helm -f` (maps deep-merge, lists are replaced wholesale), so a list
#     split across the two files would be silently clobbered, and
#     confidential clients carry secrets.
#
# Example — Google Workspace as the upstream (see
# https://dexidp.io/docs/connectors/google/), plus the clients for the
# PostgreSQL 18 device flow and for Grafana SSO (the dex marker block in
# apps/victoria-metrics and apps/kube-prometheus-stack):
#
# config:
#   connectors:
#     - type: google
#       id: google
#       name: Google
#       config:
#         clientID: <oauth-client-id>.apps.googleusercontent.com
#         clientSecret: <from the Google Cloud console>
#         redirectURI: https://dex.project1-dev.devops.coop/callback
#         hostedDomains:
#           - example.com
#         # Emitting the groups claim (Grafana's role mapping reads it)
#         # additionally needs a service account with domain-wide
#         # delegation; mount its JSON key via the chart's
#         # volumes/volumeMounts values.
#         serviceAccountFilePath: /etc/dex/google-sa.json
#         domainToAdminEmail:
#           "*": <a Workspace admin the service account impersonates>
#   staticClients:
#     # Public client for PostgreSQL 18 OAuth logins: psql/libpq runs the
#     # device authorization flow against this id; the device grant with a
#     # public client needs no secret.
#     - id: psql
#       name: psql (PostgreSQL OAuth device flow)
#       public: true
#     # Confidential client for Grafana: secret must equal the
#     # auth.generic_oauth client_secret in the monitoring app's
#     # helm_secrets.yaml — generate ONE value: openssl rand -hex 24
#     - id: grafana
#       name: Grafana
#       secret: <openssl rand -hex 24>
#       redirectURIs:
#         - https://grafana.project1-dev.devops.coop/login/generic_oauth
#     # Confidential client for Envoy Gateway's OIDC filter (the
#     # oidc-securitypolicy.yaml in the monitoring apps): secret must equal
#     # eg-oidc-client-secret in each app's eg-oidc-client.secrets.yaml.
#     # One redirect URI per protected hostname — Envoy derives the
#     # /oauth2/callback path from the incoming request, so add a line here
#     # for every HTTPRoute a SecurityPolicy targets with this client.
#     - id: envoy-gateway
#       name: Envoy Gateway (ops SSO)
#       secret: <openssl rand -hex 24>
#       redirectURIs:
#         - https://alertmanager.project1-dev.devops.coop/oauth2/callback
#         - https://vmui.project1-dev.devops.coop/oauth2/callback
#         - https://prometheus.project1-dev.devops.coop/oauth2/callback
{}
